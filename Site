    h1 span { color: var(--purple); text-shadow: 0 0 35px rgba(155,92,255,.35); }
    .hero p { max-width: 760px; margin: 0 auto; color: var(--muted); font-size: clamp(1rem, 2.5vw, 1.2rem); }
    .actions { display: flex; justify-content: center; gap: 13px; flex-wrap: wrap; margin-top: 30px; }
    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 12px 20px; border-radius: 12px; text-decoration: none; font-weight: 800; border: 1px solid var(--line); transition: .2s; }
    .btn.primary { background: linear-gradient(135deg, var(--purple2), var(--purple)); border: 0; color: white; box-shadow: 0 10px 35px rgba(113,56,216,.25); }
