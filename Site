    .section-head h2 { font-size: clamp(1.8rem, 4vw, 2.7rem); line-height: 1.15; margin: 8px 0 12px; }
    .section-head p, .muted { color: var(--muted); }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .card { background: linear-gradient(145deg, rgba(25,21,43,.95), rgba(15,13,26,.95)); border: 1px solid var(--line); padding: 23px; border-radius: 18px; }
    .card h3 { margin: 8px 0; font-size: 1.12rem; }
    .card p { color: var(--muted); margin: 0; font-size: .96rem; }
    .icon { font-size: 1.6rem; }
    .wide { display: grid; grid-template-columns: 1.1fr .9fr; gap: 22px; align-items: stretch; }
    .callout { border: 1px solid rgba(155,92,255,.35); background: linear-gradient(135deg, rgba(113,56,216,.18), rgba(18,16,32,.9)); border-radius: 20px; padding: 26px; }
    .callout h3 { margin-top: 0; }
    .callout p, .callout li { color: var(--muted); }
    ul { padding-left: 20px; }
    .specs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .spec { padding: 17px; border: 1px solid var(--line); border-radius: 14px; background: rgba(255,255,255,.025); }
    .spec small { display: block; color: var(--muted); }
    .spec strong { display: block; margin-top: 4px; }
    .steps { counter-reset: step; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .step { counter-increment: step; }
    .step:before { content: "0" counter(step); color: var(--purple); font-weight: 900; letter-spacing: .1em; }
    .notice { border-left: 3px solid var(--purple); padding: 13px 17px; background: rgba(155,92,255,.08); color: var(--muted); border-radius: 0 12px 12px 0; }
    footer { border-top: 1px solid var(--line); padding: 30px 0; color: var(--muted); font-size: .9rem; }
    footer .container { display: flex; justify-content: space-between; gap: 15px; flex-wrap: wrap; }
